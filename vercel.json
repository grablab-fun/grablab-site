{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/stickers",
      "destination": "https://t.me/addstickers/grablab_stickers_by_Grablab_news_bot",
      "permanent": false
    },
    {
      "source": "/emoji",
      "destination": "https://t.me/addemoji/grablab_emoji_by_Grablab_news_bot",
      "permanent": false
    },
    {
      "source": "/tg",
      "destination": "https://t.me/grablabfun",
      "permanent": false
    },
    {
      "source": "/telegram",
      "destination": "https://t.me/grablabfun",
      "permanent": false
    },
    {
      "source": "/((?!maintenance|assets/|api/|docs/|lab/|preview|notify|sw\\.js|styles\\.css|pages\\.css|sub\\.css|site\\.js|consent\\.js).*)",
      "destination": "/maintenance",
      "permanent": false,
      "missing": [
        {
          "type": "cookie",
          "key": "gl_preview"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/drops.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/lab/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/maintenance",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/privy/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/privy/wallet.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/preview",
      "destination": "/api/preview"
    }
  ]
}